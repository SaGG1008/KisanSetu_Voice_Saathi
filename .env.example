# Server-side secrets only. Copy to .env.local and fill values locally.
# Never commit .env.local or expose these values in browser code.

GNANI_API_KEY_ID=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_PRISMA_MODEL=prisma-v3.0

# Configure only after verifying the exact TTS model identifier.
GNANI_TIMBRE_MODEL=

# Optional reasoning provider
REASONING_PROVIDER=
REASONING_PROVIDER_API_KEY=

DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_DEFAULT_LANGUAGE=mr
